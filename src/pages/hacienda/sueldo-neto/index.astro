---
import Base from '../../../layouts/Base.astro';
import { SITE } from '../../../config';
import { BRUTOS_PAGINA, urlSueldo, base } from '../../../lib/sueldos-pagina';

const eur = (n: number, dec = 0) => n.toLocaleString('es-ES', { minimumFractionDigits: dec, maximumFractionDigits: dec, useGrouping: 'always' } as any);
const titulo = 'Sueldo neto según el bruto: tabla de 2026';
const descripcion = 'Cuánto se cobra limpio al mes con cada sueldo bruto, de 15.000 a 100.000 euros al año: neto en 14 y 12 pagas y retención de IRPF en 2026.';
const filas = BRUTOS_PAGINA.map((b) => {
  const a = base(b, 14), m = base(b, 12);
  return { b, tipo: a.tipoRetencion, mes14: a.netoMensual, extra: a.netoExtra!, mes12: m.netoMensual, anual: a.netoAnual };
});
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Hacienda', item: `${SITE.url}/hacienda/` },
    { '@type': 'ListItem', position: 3, name: 'Sueldo neto según el bruto', item: `${SITE.url}/hacienda/sueldo-neto/` },
  ],
};
---
<Base title={titulo} description={descripcion} jsonLd={jsonLd}>
  <nav class="breadcrumbs"><a href="/">Inicio</a> › <a href="/hacienda/">Hacienda</a></nav>
  <article class="hub">
    <h1>{titulo}</h1>
    <p class="lead">Lo que queda limpio de cada sueldo bruto en 2026 para una persona soltera, sin hijos y con contrato indefinido. Pulsa en un sueldo para ver el desglose de la nómina y cómo cambia con hijos o con otro tipo de contrato. Para tu caso exacto, usa la <a href="/hacienda/calculadora-sueldo-neto/">calculadora de sueldo neto</a>.</p>
    <div class="tabla-scroll">
      <table class="tabla">
        <thead><tr><th scope="col">Bruto anual</th><th scope="col">Retención</th><th scope="col">Neto al mes (14 pagas)</th><th scope="col">Paga extra</th><th scope="col">Neto al mes (12 pagas)</th><th scope="col">Neto al año</th></tr></thead>
        <tbody>
          {filas.map((f) => (
            <tr><th scope="row"><a href={urlSueldo(f.b)}>{eur(f.b)} €</a></th><td>{eur(f.tipo, 2)} %</td><td>{eur(f.mes14)} €</td><td>{eur(f.extra)} €</td><td>{eur(f.mes12)} €</td><td>{eur(f.anual)} €</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted small">Territorio común (toda España salvo País Vasco y Navarra). Retención con el algoritmo de la Agencia Tributaria vigente desde el 10 de septiembre de 2026 y cotizaciones de la Seguridad Social de 2026.</p>
  </article>
</Base>
<style>
  .hub { max-width: 900px; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 4px 0 12px; max-width: 24ch; }
  .lead { font-size: 1.0625rem; line-height: 1.55; max-width: 70ch; margin: 0 0 20px; }
  .tabla-scroll { overflow-x: auto; }
  .tabla { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  .tabla th, .tabla td { padding: 7px 12px 7px 0; border-bottom: 1px solid var(--rule); text-align: right; font-size: .9375rem; white-space: nowrap; }
  .tabla th:first-child { text-align: left; }
  .tabla thead th { font-size: .8125rem; font-weight: 600; border-bottom: 1px solid var(--ink); white-space: normal; vertical-align: bottom; }
  .tabla tbody th { font-weight: 600; }
  .small { font-size: .8125rem; }
</style>
