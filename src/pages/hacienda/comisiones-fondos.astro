---
// La calculadora de comisiones vive en Dinero en Claro (web de inversión). Esta dirección redirige allí
// para no tener la misma página en dos webs, que compiten entre sí en Google.
const destino = 'https://dineroenclaro.com/fondos/comisiones/';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Calculadora de comisiones de fondos</title>
    <link rel="canonical" href={destino} />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
  </head>
  <body>
    <p>La calculadora de comisiones de fondos y planes de pensiones está ahora en <a href={destino}>Dinero en Claro</a>.</p>
  </body>
</html>
