---
import Base from '../../layouts/Base.astro';
import CalendarioCobro from '../../components/CalendarioCobro.astro';
import Siguenos from '../../components/Siguenos.astro';
import { SITE } from '../../config';
import cobros from '../../data/cobros.json';
const t = (cobros as any)['paro'];
const titulo = 'Cuándo se cobra el paro: fechas de cada banco';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Empleo y paro', item: `${SITE.url}/paro/` },
    { '@type': 'ListItem', position: 3, name: titulo, item: `${SITE.url}/paro/cuando-se-cobra/` },
  ],
};
---
<Base title={titulo} description="Qué día ingresa el SEPE el paro, cuándo llega a cada banco y por qué se cobra a mes vencido." jsonLd={jsonLd}>
  <nav class="breadcrumbs"><a href="/">Inicio</a> › <a href="/paro/">Empleo y paro</a></nav>
  <article class="guia">
    <h1>{titulo}</h1>
    <p class="lead">{t.regla}</p>
    <CalendarioCobro tipo="paro" />
    <section class="prose">
      <h2>Pagas extra</h2>
      <p>{t.extras}</p>
      <h2>Si no te ha llegado el dinero</h2>
      <p>Las fechas de los bancos son un adelanto voluntario. Si tu banco no lo adelanta o hay una incidencia, el ingreso llega como tarde en la fecha oficial. Antes de reclamar, consulta a tu banco; si el problema es del pago en sí, contacta con {'paro' === 'pensiones' ? 'la Seguridad Social' : 'el SEPE'}.</p>
      <p class="muted small">Fuentes de la norma general: {t.fuentes_regla.map((f: any, i: number) => <>{i > 0 && ' · '}<a href={f.url} rel="nofollow noopener" target="_blank">{f.name}</a></>)}.</p>
    </section>
    <Siguenos />
  </article>
</Base>
<style>
  .guia { max-width: 720px; }
  h1 { font-size: clamp(1.9rem, 4.6vw, 2.6rem); line-height: 1.15; margin: 4px 0 12px; }
  .lead { font-size: 1.125rem; line-height: 1.55; margin: 0 0 32px; }
</style>
