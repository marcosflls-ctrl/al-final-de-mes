---
import Base from '../../layouts/Base.astro';
import Siguenos from '../../components/Siguenos.astro';
import Compartir from '../../components/Compartir.astro';
import { SITE } from '../../config';
import { datosLuz, fechaLarga } from '../../lib/luz';

// Precio medio de la luz (PVPC) de los días guardados, con impuestos: el mismo cálculo que en el resto de la web
const IEE = 0.0511269632;
const IVA = 0.21;
const luz = datosLuz();
const horas = luz ? Object.values(luz.dias).flat() : [];
const mediaLuz = horas.length ? horas.reduce((s, x) => s + x.p, 0) / horas.length : 0.15;
const luzConImp = mediaLuz * (1 + IEE) * (1 + IVA);
const diasLuz = luz ? Object.keys(luz.dias).sort() : [];
const desdeLuz = diasLuz[0];
const hastaLuz = diasLuz[diasLuz.length - 1];

// Precios de referencia de los demás combustibles (revisar cada mes en invierno)
// - Gas natural: TUR 1 desde el 1/10/2026, término variable 0,05257298 €/kWh sin impuestos (BOE-A-2026-20265);
//   con el IVA del 21 % y el impuesto de hidrocarburos, unos 0,066 €/kWh. No incluye el término fijo.
// - Gasóleo C: media nacional de 1,75 €/l el 19/10/2026 (Geoportal del Ministerio para la Transición Ecológica).
// - Pellets: saco de 15 kg a 5,67 € con IVA en el 2.º trimestre de 2026 (índice de AVEBIOM).
// - Butano: bombona de 12,5 kg a 18,84 €, precio máximo vigente (con el tope de 19,55 € hasta junio de 2027).
const PRECIOS_FECHA = 'octubre de 2026';

const sistemas = [
  { id: 'radiador', nombre: 'Radiadores o estufas eléctricas', unidad: '€/kWh de luz', precio: +luzConImp.toFixed(3), paso: 0.001, kwhUnidad: 1, rendimiento: 100, ayudaRend: 'Toda la electricidad se convierte en calor.' },
  { id: 'bomba', nombre: 'Bomba de calor o aerotermia', unidad: '€/kWh de luz', precio: +luzConImp.toFixed(3), paso: 0.001, kwhUnidad: 1, rendimiento: 300, ayudaRend: 'Por cada kWh de luz da unos 3 kWh de calor (300 %). Las más eficientes llegan a 400 %.' },
  { id: 'gas', nombre: 'Caldera de gas natural', unidad: '€/kWh de gas', precio: 0.066, paso: 0.001, kwhUnidad: 1, rendimiento: 92, ayudaRend: 'Las de condensación rinden más del 95 %; las antiguas, alrededor del 85 %.' },
  { id: 'gasoleo', nombre: 'Caldera de gasóleo', unidad: '€/litro', precio: 1.75, paso: 0.01, kwhUnidad: 10, rendimiento: 88, ayudaRend: 'Un litro de gasóleo C da unos 10 kWh.' },
  { id: 'pellets', nombre: 'Estufa o caldera de pellets', unidad: '€/kg', precio: 0.378, paso: 0.001, kwhUnidad: 4.76, rendimiento: 87, ayudaRend: 'Un kilo de pellets da unos 4,8 kWh. Un saco de 15 kg a 5,67 € son 0,378 €/kg.' },
  { id: 'butano', nombre: 'Estufa de butano', unidad: '€/bombona de 12,5 kg', precio: 18.84, paso: 0.01, kwhUnidad: 158, rendimiento: 95, ayudaRend: 'Una bombona da unos 158 kWh.' },
];

const zonas = [
  { id: 'calida', nombre: 'Cálida: costa mediterránea, sur y Canarias', kwhM2: 30 },
  { id: 'media', nombre: 'Media: costa atlántica y cantábrica, interior de Andalucía y de Levante', kwhM2: 60 },
  { id: 'fria', nombre: 'Fría: Madrid, las dos Castillas, Aragón, La Rioja, Navarra, interior de Galicia y montaña', kwhM2: 100 },
];

const titulo = 'Calculadora de calefacción: qué sale más barato este invierno';
const descripcion = 'Compara lo que te cuesta calentar tu casa con radiadores eléctricos, bomba de calor, gas natural, gasóleo, pellets o butano, con los precios de este otoño.';
const url = `${SITE.url}/luz/calculadora-calefaccion/`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Precio de la luz', item: `${SITE.url}/luz/` },
      { '@type': 'ListItem', position: 3, name: titulo, item: url },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: titulo, url, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', inLanguage: 'es-ES', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' } },
];
const datosCliente = { sistemas, zonas };
---
<Base title={titulo} description={descripcion} jsonLd={jsonLd}>
  <nav class="breadcrumbs"><a href="/">Inicio</a> › <a href="/luz/">Precio de la luz</a></nav>
  <article class="pagina">
    <h1>Calculadora de calefacción</h1>
    <p class="lead">Compara cuánto te cuesta calentar tu casa durante el invierno con cada sistema. Pon los metros y la zona, o tu consumo si lo conoces, y cambia los precios si pagas otros.</p>

    <form id="calc-cal" class="formulario" novalidate>
      <fieldset>
        <legend>Tu casa</legend>
        <div class="campos">
          <label class="campo"><span>Metros cuadrados que calientas</span>
            <span class="u"><input name="m2" type="number" inputmode="decimal" min="0" step="1" value="80" /><i>m²</i></span></label>
          <label class="campo"><span>Zona climática</span>
            <select name="zona">{zonas.map((z) => <option value={z.id} selected={z.id === 'media'}>{z.nombre}</option>)}</select></label>
          <label class="campo"><span>O tu consumo de calor al año, si lo sabes</span>
            <span class="u"><input name="kwh" type="number" inputmode="decimal" min="0" step="100" placeholder="opcional" /><i>kWh</i></span>
            <small class="muted">Si lo rellenas, se usa en lugar de los metros y la zona.</small></label>
        </div>
      </fieldset>
    </form>

    <section class="res" aria-live="polite">
      <p class="veredicto" id="veredicto">—</p>
      <p class="muted small" id="necesidad"></p>
      <ol class="ranking" id="ranking"></ol>
    </section>

    <details class="precios">
      <summary>Cambiar los precios y rendimientos</summary>
      <div class="tabla-precios">
        {sistemas.map((s) => (
          <div class="fila">
            <strong>{s.nombre}</strong>
            <label class="campo"><span>Precio</span><span class="u"><input data-sis={s.id} data-campo="precio" type="number" inputmode="decimal" step={s.paso} min="0" value={s.precio} /><i>{s.unidad}</i></span></label>
            <label class="campo"><span>Rendimiento</span><span class="u"><input data-sis={s.id} data-campo="rendimiento" type="number" inputmode="decimal" step="1" min="1" value={s.rendimiento} /><i>%</i></span></label>
            <small class="muted">{s.ayudaRend}</small>
          </div>
        ))}
      </div>
    </details>

    <Compartir title={titulo} url={url} />

    <section class="prose">
      <h2>De dónde salen los precios</h2>
      <ul>
        <li><strong>Luz:</strong> la media de la tarifa regulada (PVPC) {desdeLuz && hastaLuz ? `del ${fechaLarga(desdeLuz)} al ${fechaLarga(hastaLuz)}` : 'de los últimos días'}, con el impuesto eléctrico y el IVA: {luzConImp.toLocaleString('es-ES', { minimumFractionDigits: 3, maximumFractionDigits: 3 })} €/kWh. Se actualiza sola con el <a href="/luz/">precio de la luz de cada día</a>. No incluye la potencia contratada, que pagas igual uses o no la calefacción.</li>
        <li><strong>Gas natural:</strong> la tarifa regulada TUR 1 desde el 1 de octubre de 2026, con impuestos y sin el término fijo.</li>
        <li><strong>Gasóleo de calefacción:</strong> la media nacional del 19 de octubre de 2026 según el Ministerio para la Transición Ecológica.</li>
        <li><strong>Pellets:</strong> el saco de 15 kg del índice de precios de AVEBIOM del segundo trimestre de 2026.</li>
        <li><strong>Butano:</strong> el precio máximo de la bombona de 12,5 kg.</li>
      </ul>
      <p>Revisamos estos precios cada mes durante el invierno. Última revisión: {PRECIOS_FECHA}.</p>
      <h2>Cómo calculamos el consumo</h2>
      <p>Si no pones tu consumo, lo estimamos multiplicando los metros por el calor que necesita al año una vivienda media de cada zona: 30, 60 o 100 kWh por metro cuadrado. Una casa bien aislada puede necesitar la mitad; una mal aislada, el doble. Si tienes las facturas de un invierno, el resultado será mucho más preciso.</p>
      <h2>Lo que la calculadora no tiene en cuenta</h2>
      <ul>
        <li><strong>Lo que cuesta el aparato y su instalación.</strong> Una bomba de calor o una caldera de pellets son más caras de comprar; a cambio, suelen gastar menos.</li>
        <li><strong>Los términos fijos</strong> de la luz y del gas, y el mantenimiento de las calderas.</li>
        <li><strong>Las ayudas:</strong> las obras que mejoran la eficiencia de tu casa pueden desgravar en el IRPF hasta el 31 de diciembre de 2026, y el <a href="/luz/bono-social-electrico-requisitos-y-descuentos/">bono social</a> rebaja la luz a quien cumple los requisitos.</li>
      </ul>
      <p>Para ahorrar con la luz, mira a qué horas es más barata en <a href="/luz/cuanto-cuesta-cada-electrodomestico/">cuánto cuesta cada electrodoméstico hoy</a>.</p>
      <p class="muted small">Calculadora orientativa. El coste real depende del aislamiento, la temperatura a la que tengas la casa y las horas que la uses.</p>
    </section>
    <Siguenos />
  </article>
</Base>

<script define:vars={{ datosCliente }}>
  window.__calefaccion = datosCliente;
</script>

<script>
  type Sistema = { id: string; nombre: string; unidad: string; precio: number; kwhUnidad: number; rendimiento: number };
  type Zona = { id: string; nombre: string; kwhM2: number };
  const { sistemas, zonas } = (window as any).__calefaccion as { sistemas: Sistema[]; zonas: Zona[] };
  const form = document.getElementById('calc-cal') as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id)!;
  const eur = (n: number) => Math.round(n).toLocaleString('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions) + ' €';
  const num = (v: string | null | undefined) => parseFloat(String(v ?? '').replace(',', '.'));

  function leerSistema(s: Sistema) {
    const p = num((document.querySelector(`[data-sis="${s.id}"][data-campo="precio"]`) as HTMLInputElement)?.value);
    const r = num((document.querySelector(`[data-sis="${s.id}"][data-campo="rendimiento"]`) as HTMLInputElement)?.value);
    return { ...s, precio: isFinite(p) ? p : s.precio, rendimiento: isFinite(r) && r > 0 ? r : s.rendimiento };
  }

  function calcular() {
    const d = new FormData(form);
    const zona = zonas.find((z) => z.id === d.get('zona')) ?? zonas[1];
    const m2 = Math.max(0, num(d.get('m2') as string) || 0);
    const propio = num(d.get('kwh') as string);
    const calor = isFinite(propio) && propio > 0 ? propio : m2 * zona.kwhM2;
    $('necesidad').textContent = isFinite(propio) && propio > 0
      ? `Calculado con tu consumo: ${calor.toLocaleString('es-ES')} kWh de calor al año.`
      : `Estimación: ${m2} m² × ${zona.kwhM2} kWh por m² = ${Math.round(calor).toLocaleString('es-ES')} kWh de calor al año.`;
    const res = sistemas.map(leerSistema).map((s) => {
      const precioKwhCalor = s.precio / s.kwhUnidad / (s.rendimiento / 100);
      return { ...s, anual: calor * precioKwhCalor, precioKwhCalor };
    }).sort((a, b) => a.anual - b.anual);
    const max = Math.max(...res.map((r) => r.anual), 1);
    $('ranking').innerHTML = res.map((r) => `
      <li>
        <div class="fila-res"><span class="nombre">${r.nombre}</span><strong>${eur(r.anual)} al año</strong></div>
        <div class="barra"><span style="width:${Math.max(2, (r.anual / max) * 100).toFixed(1)}%"></span></div>
        <small class="muted">${(r.precioKwhCalor * 100).toLocaleString('es-ES', { maximumFractionDigits: 1 })} céntimos por kWh de calor · unos ${eur(r.anual / 5)} al mes en un invierno de cinco meses</small>
      </li>`).join('');
    const barato = res[0], caro = res[res.length - 1];
    $('veredicto').innerHTML = calor > 0
      ? `Lo más barato: <strong>${barato.nombre.toLowerCase()}</strong>, unos ${eur(barato.anual)} al año. Lo más caro, ${caro.nombre.toLowerCase()}: ${eur(caro.anual - barato.anual)} más.`
      : 'Pon los metros de tu casa o tu consumo.';
  }
  document.addEventListener('input', (e) => { if ((e.target as HTMLElement).closest('#calc-cal, .precios')) calcular(); });
  document.addEventListener('change', (e) => { if ((e.target as HTMLElement).closest('#calc-cal, .precios')) calcular(); });
  calcular();
</script>

<style>
  .pagina { max-width: 860px; }
  h1 { font-size: clamp(1.9rem, 4.6vw, 2.6rem); line-height: 1.15; margin: 4px 0 12px; }
  .lead { font-size: 1.125rem; line-height: 1.55; margin: 0 0 24px; max-width: 720px; }
  .formulario { margin-bottom: 24px; }
  fieldset { border: 0; margin: 0; padding: 0; }
  legend { font-family: var(--serif); font-weight: 600; font-size: 1.25rem; margin-bottom: 10px; padding: 0; }
  .campos { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px 20px; }
  .campo { display: flex; flex-direction: column; gap: 6px; }
  .campo > span:first-child { font-weight: 600; font-size: .875rem; }
  .campo small { font-size: .78rem; line-height: 1.4; }
  .u { position: relative; display: block; }
  .u i { position: absolute; right: 11px; top: 50%; transform: translateY(-50%); font-style: normal; color: var(--muted); font-size: .8rem; pointer-events: none; }
  .u input, select { font: 400 1rem var(--sans); padding: 9px 11px; border: 1px solid #b9c0c6; border-radius: 4px; width: 100%; color: var(--ink); background: var(--bg); font-variant-numeric: tabular-nums; }
  .u input { padding-right: 130px; }
  .u input:focus, select:focus { outline: 2px solid var(--brand); outline-offset: 0; }
  .res { background: var(--surface); border-radius: 4px; padding: 22px 24px; border-top: 2px solid var(--ink); }
  .veredicto { font-family: var(--serif); font-size: 1.375rem; line-height: 1.35; margin: 0 0 6px; }
  .veredicto :global(strong) { color: var(--brand-dark); }
  .small { font-size: .8125rem; }
  .ranking { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .ranking :global(.fila-res) { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .ranking :global(.nombre) { font-weight: 600; }
  .ranking :global(strong) { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ranking :global(.barra) { height: 8px; background: var(--rule); border-radius: 4px; margin: 6px 0 4px; overflow: hidden; }
  .ranking :global(.barra span) { display: block; height: 100%; background: var(--brand); border-radius: 4px; }
  .ranking :global(small) { font-size: .8rem; }
  .precios { margin-top: 20px; border: 1px solid var(--rule); border-radius: 4px; padding: 12px 16px; }
  .precios summary { cursor: pointer; font-weight: 600; }
  .tabla-precios { display: flex; flex-direction: column; gap: 18px; margin-top: 14px; }
  .fila { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
  .fila strong { grid-column: 1 / -1; }
  .fila small { grid-column: 1 / -1; font-size: .78rem; }
  .prose { margin-top: 36px; }
  @media (max-width: 600px) {
    .res { padding: 18px 16px; }
    .fila { grid-template-columns: 1fr; }
    .veredicto { font-size: 1.2rem; }
  }
</style>
