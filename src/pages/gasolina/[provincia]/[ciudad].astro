---
import Base from '../../../layouts/Base.astro';
import Carburantes from '../../../components/Carburantes.astro';
import AhorroRepostar from '../../../components/AhorroRepostar.astro';
import { SITE } from '../../../config';
import { datosCarburantes, datosCiudades, ciudadHaceUnaSemana, litro, type Ciudad } from '../../../lib/carburantes';
import { fechaLarga } from '../../../lib/luz';

export function getStaticPaths() {
  const provincias = new Set((datosCarburantes()?.provincias ?? []).map((p) => p.slug));
  return datosCiudades()
    .filter((c) => provincias.has(c.provincia_slug))
    .map((c) => ({ params: { provincia: c.provincia_slug, ciudad: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Ciudad };
const d = datosCarburantes()!;
const prov = d.provincias.find((p) => p.slug === c.provincia_slug)!;
const vecinas = datosCiudades().filter((x) => x.provincia_slug === c.provincia_slug && x.slug !== c.slug);
const titulo = `Precio de la gasolina hoy en ${c.nombre}: las más baratas`;
const h1 = `Precio de la gasolina hoy en ${c.nombre}`;
const comp = (k: 'g95' | 'diesel') => {
  const a = c[k]?.media, b = prov[k]?.media;
  if (a == null || b == null) return '';
  const dif = a - b;
  return Math.abs(dif) < 0.0005 ? `igual que la media de la provincia` : `${litro(Math.abs(dif))} € ${dif > 0 ? 'más cara' : 'más barata'} que la media de la provincia de ${prov.nombre}`;
};
// Ahorro llenando un depósito de 50 litros en la más barata frente a la media
const ahorro = c.g95 ? (c.g95.media - c.g95.min) * 50 : 0;
const ahorroDiesel = c.diesel ? (c.diesel.media - c.diesel.min) * 50 : 0;
const eur0 = (n: number) => n.toLocaleString('es-ES', { maximumFractionDigits: 0 });
// Frente a la media de España y frente a hace una semana
const nac = d.nacional;
const frenteEspana = (k: 'g95' | 'diesel') => {
  const a = c[k]?.media, b = nac[k]?.media;
  if (a == null || b == null) return '';
  const dif = a - b;
  return Math.abs(dif) < 0.0005 ? 'igual que la media de España' : `${litro(Math.abs(dif))} € ${dif > 0 ? 'más cara' : 'más barata'} que la media de España (${litro(b)} €/l)`;
};
const clave = `${c.provincia_slug}/${c.slug}`;
const antes = { g95: ciudadHaceUnaSemana(clave, 'g95'), diesel: ciudadHaceUnaSemana(clave, 'diesel') };
const cambioG95 = c.g95 && antes.g95 != null ? c.g95.media - antes.g95 : undefined;
const cambioDiesel = c.diesel && antes.diesel != null ? c.diesel.media - antes.diesel : undefined;
const masBarataG95 = c.baratas_g95?.[0];
const masBarataDiesel = c.baratas_diesel?.[0];
const lowcost = (c.baratas_g95 ?? []).map((g) => g.rotulo).filter(Boolean);
const marcas = [...new Set(lowcost)].slice(0, 3);
const preguntas = [
  masBarataG95 && {
    q: `¿Dónde está la gasolina más barata en ${c.nombre}?`,
    a: `Con los precios del ${fechaLarga(d.fecha)}, la gasolina 95 más barata de ${c.nombre} está en ${masBarataG95.rotulo || 'una gasolinera sin rótulo'} (${masBarataG95.direccion}, ${masBarataG95.localidad}), a ${litro(masBarataG95.p)} €/l.${masBarataDiesel ? ` El diésel más barato está en ${masBarataDiesel.rotulo || 'una gasolinera sin rótulo'} (${masBarataDiesel.direccion}), a ${litro(masBarataDiesel.p)} €/l.` : ''}`,
  },
  c.g95 && {
    q: `¿Cuánto cuesta llenar el depósito en ${c.nombre}?`,
    a: `Un depósito de 50 litros de gasolina 95 cuesta de media unos ${eur0(c.g95.media * 50)} € en ${c.nombre}, y unos ${eur0(c.g95.min * 50)} € en la gasolinera más barata.${c.diesel ? ` Con diésel, unos ${eur0(c.diesel.media * 50)} € de media y ${eur0(c.diesel.min * 50)} € en la más barata.` : ''}`,
  },
  c.g95 && nac.g95 && {
    q: `¿La gasolina es más cara en ${c.nombre} que en el resto de España?`,
    a: `La gasolina 95 está ${frenteEspana('g95')}${c.diesel && nac.diesel ? ` y el diésel, ${frenteEspana('diesel')}` : ''}. Dentro de su provincia, está ${comp('g95')}.`,
  },
  marcas.length > 0 && {
    q: `¿Qué gasolineras son las más baratas en ${c.nombre}?`,
    a: `Entre las diez más baratas de gasolina 95 en ${c.nombre} aparecen sobre todo ${marcas.join(', ')}. Los precios los comunica cada gasolinera al Ministerio y pueden cambiar a lo largo del día; no incluyen descuentos de tarjetas ni promociones.`,
  },
].filter(Boolean) as { q: string; a: string }[];
const desc = `Gasolina 95 a ${litro(c.g95?.media)} €/l y diésel a ${litro(c.diesel?.media)} €/l de media hoy en ${c.nombre} (${c.provincia}), y las gasolineras más baratas del municipio.`;
const url = `${SITE.url}/gasolina/${c.provincia_slug}/${c.slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Gasolina y diésel', item: `${SITE.url}/gasolina/` },
      { '@type': 'ListItem', position: 3, name: prov.nombre, item: `${SITE.url}/gasolina/${prov.slug}/` },
      { '@type': 'ListItem', position: 4, name: c.nombre, item: url },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: preguntas.map((p) => ({ '@type': 'Question', name: p.q, acceptedAnswer: { '@type': 'Answer', text: p.a } })),
  },
];
---
<Base title={titulo} description={desc.slice(0, 165)} jsonLd={jsonLd}>
  <nav class="breadcrumbs"><a href="/">Inicio</a> › <a href="/gasolina/">Gasolina y diésel</a> › <a href={`/gasolina/${prov.slug}/`}>{prov.nombre}</a> › {c.nombre}</nav>
  <h1>{h1}</h1>
  <p class="intro">Con los precios del {fechaLarga(d.fecha)}, la gasolina 95 cuesta de media <strong>{litro(c.g95?.media)} €/l</strong> en las {c.g95?.n} gasolineras de {c.nombre} ({comp('g95')}) y el diésel, <strong>{litro(c.diesel?.media)} €/l</strong> ({comp('diesel')}).{ahorro >= 1 && <> Llenar un depósito de 50 litros de gasolina en la más barata del municipio ahorra unos <strong>{ahorro.toLocaleString('es-ES', { maximumFractionDigits: 0 })} €</strong> frente al precio medio{ahorroDiesel >= 1 && <>, y de diésel, unos <strong>{eur0(ahorroDiesel)} €</strong></>}.</>}{c.g95 && nac.g95 && <> En el conjunto de España, la gasolina 95 de {c.nombre} está {frenteEspana('g95')}.</>}</p>
  <Carburantes g95={c.g95} diesel={c.diesel} baratasG95={c.baratas_g95} baratasDiesel={c.baratas_diesel} ambito={c.nombre} cambioG95={cambioG95} cambioDiesel={cambioDiesel} />
  <AhorroRepostar g95={c.g95} diesel={c.diesel} ambito={c.nombre} />
  {preguntas.length > 0 && (
    <section class="faq">
      <h2>Preguntas frecuentes</h2>
      {preguntas.map((p) => (<><h3>{p.q}</h3><p>{p.a}</p></>))}
    </section>
  )}
  {vecinas.length > 0 && (
    <section class="vecinas">
      <h2>Otros municipios de {prov.nombre}</h2>
      <ul>{vecinas.map((v) => <li><a href={`/gasolina/${v.provincia_slug}/${v.slug}/`}>{v.nombre}</a> <span class="muted">{litro(v.g95?.media)} €/l</span></li>)}</ul>
    </section>
  )}
  <p class="muted small nota-fuente">Fuente: <a href="https://geoportalgasolineras.es/" rel="noopener" target="_blank">Geoportal de Hidrocarburos</a> del Ministerio para la Transición Ecológica. Los precios incluyen impuestos y los comunica cada gasolinera; pueden cambiar a lo largo del día. <a href={`/gasolina/${prov.slug}/`}>Ver toda la provincia de {prov.nombre}</a>.</p>
</Base>
<style>
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 4px 0 10px; max-width: 24ch; }
  .intro { max-width: 68ch; margin: 0 0 24px; font-size: 1.0625rem; }
  .vecinas { margin-top: 32px; }
  .faq { margin-top: 32px; max-width: 72ch; }
  .faq h3 { font-size: 1.0625rem; margin: 18px 0 4px; }
  .faq p { margin: 0; }
  .vecinas ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 6px 20px; }
  .vecinas .muted { font-size: .875rem; font-variant-numeric: tabular-nums; }
  .nota-fuente { margin-top: 24px; max-width: 72ch; }
</style>
