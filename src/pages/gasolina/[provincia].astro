---
import Base from '../../layouts/Base.astro';
import Carburantes from '../../components/Carburantes.astro';
import { SITE } from '../../config';
import { datosCarburantes, litro, type Provincia } from '../../lib/carburantes';
import { fechaLarga } from '../../lib/luz';

export function getStaticPaths() {
  const d = datosCarburantes();
  return (d?.provincias ?? []).map((p) => ({ params: { provincia: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Provincia };
const d = datosCarburantes()!;
const n = d.nacional;
const titulo = `Precio de la gasolina hoy en ${p.nombre}`;
const comp = (k: 'g95' | 'diesel') => {
  const a = p[k]?.media, b = n[k]?.media;
  if (a == null || b == null) return '';
  const dif = a - b;
  return Math.abs(dif) < 0.0005 ? 'igual que la media de España' : `${litro(Math.abs(dif))} € ${dif > 0 ? 'más cara' : 'más barata'} que la media de España`;
};
const desc = `Precio medio de la gasolina 95 (${litro(p.g95?.media)} €/l) y el diésel (${litro(p.diesel?.media)} €/l) hoy en ${p.nombre}, y las gasolineras más baratas de la provincia.`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Gasolina y diésel', item: `${SITE.url}/gasolina/` },
    { '@type': 'ListItem', position: 3, name: p.nombre, item: `${SITE.url}/gasolina/${p.slug}/` },
  ],
};
---
<Base title={titulo} description={desc.slice(0, 165)} jsonLd={jsonLd}>
  <nav class="breadcrumbs"><a href="/">Inicio</a> › <a href="/gasolina/">Gasolina y diésel</a> › {p.nombre}</nav>
  <h1>{titulo}</h1>
  <p class="intro">Hoy, {fechaLarga(d.fecha)}, la gasolina 95 cuesta de media <strong>{litro(p.g95?.media)} €/l</strong> en {p.nombre} ({comp('g95')}) y el diésel, <strong>{litro(p.diesel?.media)} €/l</strong> ({comp('diesel')}).</p>
  <Carburantes g95={p.g95} diesel={p.diesel} baratasG95={p.baratas_g95} baratasDiesel={p.baratas_diesel} ambito={p.nombre} />
  <p class="muted small nota-fuente">Fuente: <a href="https://geoportalgasolineras.es/" rel="noopener" target="_blank">Geoportal de Hidrocarburos</a> del Ministerio para la Transición Ecológica. Los precios incluyen impuestos y los comunica cada gasolinera; pueden cambiar a lo largo del día. <a href="/gasolina/">Ver todas las provincias</a>.</p>
</Base>
<style>
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 4px 0 10px; max-width: 24ch; }
  .intro { max-width: 68ch; margin: 0 0 24px; font-size: 1.0625rem; }
  .nota-fuente { margin-top: 24px; max-width: 72ch; }
</style>
