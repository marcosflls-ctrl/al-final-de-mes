---
// Calculadora de la actualización anual del alquiler con las reglas del Real Decreto-ley 29/2026.
// Los datos (IPC y IRAV) salen de src/data/ipc.json, que el robot del IPC actualiza cada mes.
// Si el decreto no se convalida el 12 de noviembre de 2026 (o se cambia), hay que revisar DECRETO y los textos.
import Base from '../../layouts/Base.astro';
import Siguenos from '../../components/Siguenos.astro';
import Compartir from '../../components/Compartir.astro';
import { SITE } from '../../config';
import { datosIPC, nombreMes } from '../../lib/ipc';

const d = datosIPC();
const irav = (d as any)?.irav as Record<string, number> | undefined;
const mesIpc = d?.mes ?? '';
const ipc = d?.general.va?.[mesIpc] ?? null;
const mesIrav = irav ? Object.keys(irav).sort().at(-1)! : '';
const iravHoy = irav?.[mesIrav] ?? null;
// Estado del decreto: 'vigente' (pendiente de convalidar), 'convalidado' o 'derogado'
const DECRETO = { estado: 'vigente', tope: 2, hasta: '31 de diciembre de 2027', votacion: '12 de noviembre' };
const DATOS = { ipc, irav: iravHoy, tope: DECRETO.estado === 'derogado' ? null : DECRETO.tope };

const titulo = 'Calculadora de la subida del alquiler: cuánto te pueden subir';
const descripcion = `Calcula cuánto te pueden subir el alquiler al renovar el año: con el límite del 2 % del decreto de vivienda, el IPC (${ipc ?? '—'} %) y el IRAV (${iravHoy ?? '—'} %).`;
const url = `${SITE.url}/vivienda/actualizar-alquiler-ipc/`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Vivienda', item: `${SITE.url}/vivienda/` },
    { '@type': 'ListItem', position: 3, name: 'Subida del alquiler', item: url } ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: titulo, url, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', inLanguage: 'es-ES', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' } },
];
const fmt = (v: number | null) => (v == null ? '—' : `${v.toLocaleString('es-ES', { maximumFractionDigits: 2 })} %`);
---
<Base title={titulo} description={descripcion} jsonLd={jsonLd}>
  <nav class="breadcrumbs"><a href="/">Inicio</a> › <a href="/vivienda/">Vivienda</a></nav>
  <article class="pagina">
    <h1>¿Cuánto te pueden subir el alquiler?</h1>
    <p class="lead">Cuando el contrato cumple un año, el casero puede actualizar la renta. Pon lo que pagas y lo que dice tu contrato y te decimos el máximo que te pueden subir con las reglas de ahora.</p>

    <section class="res" aria-live="polite">
      <p class="veredicto" id="veredicto">—</p>
      <div class="dos">
        <p><span class="muted">Subida máxima</span><strong id="r-pct">—</strong></p>
        <p><span class="muted">Nuevo alquiler como máximo</span><strong id="r-nuevo">—</strong></p>
      </div>
      <p class="small" id="r-detalle"></p>
      <p class="small muted" id="r-sin"></p>
    </section>

    <form id="calc-alq" class="formulario" novalidate>
      <label class="campo"><span>Lo que pagas ahora al mes</span>
        <span class="u"><input name="renta" type="number" inputmode="decimal" min="0" step="10" value="900" /><i>€/mes</i></span>
      </label>
      <label class="campo"><span>Qué dice tu contrato sobre la subida anual</span>
        <select name="clausula">
          <option value="ipc">Que sube con el IPC</option>
          <option value="irav">Que sube con el IRAV (índice de alquileres)</option>
          <option value="generica">Que se actualiza, sin decir con qué índice</option>
          <option value="ninguna">No dice nada de actualizar la renta</option>
        </select>
      </label>
      <label class="campo"><span>Cuándo firmaste el contrato</span>
        <select name="firma">
          <option value="nuevo">Desde el 26 de mayo de 2023</option>
          <option value="viejo">Antes del 26 de mayo de 2023</option>
        </select>
      </label>
      <label class="campo"><span>¿Habéis pactado ahora otra subida?</span>
        <select name="pacto">
          <option value="no">No, el casero solo aplica el contrato</option>
          <option value="si">Sí, hemos acordado una subida</option>
        </select>
      </label>
      <label class="campo" id="campo-pactada" hidden><span>Subida que habéis acordado</span>
        <span class="u"><input name="pactada" type="number" inputmode="decimal" min="0" step="0.1" value="3" /><i>%</i></span>
      </label>
      <label class="check"><input name="tensionada" type="checkbox" /> <span>Vivo en una zona tensionada y mi alquiler está <strong>por encima del índice de precios de referencia</strong></span></label>
    </form>

    <p class="aviso"><strong>Ojo:</strong> el límite del {DECRETO.tope} % viene del Real Decreto-ley 29/2026, en vigor desde el 8 de octubre de 2026 pero <strong>pendiente de que el Congreso lo convalide el {DECRETO.votacion}</strong>. Si no se convalida, decae y vuelven las reglas anteriores, que te mostramos debajo del resultado. Actualizaremos esta página en cuanto se vote.</p>

    <Compartir title={titulo} url={url} />

    <section class="prose">
      <h2>Los datos de este mes</h2>
      <ul>
        <li><strong>IPC:</strong> {fmt(ipc)} en {mesIpc ? nombreMes(mesIpc) : '—'}, el último publicado por el INE. Es la subida de precios en un año.</li>
        <li><strong>IRAV (índice de referencia para la actualización de los alquileres):</strong> {fmt(iravHoy)} en {mesIrav ? nombreMes(mesIrav) : '—'}. Lo publica el INE desde 2025 y es el tope legal de la subida anual.</li>
        <li><strong>Límite extraordinario:</strong> {DECRETO.tope} % hasta el {DECRETO.hasta}, si no hay un nuevo acuerdo entre casero e inquilino.</li>
      </ul>
      <p>Se usa el último dato publicado en la fecha en que toca actualizar. Esta página se actualiza sola cada mes con los datos del INE. Puedes ver cómo evolucionan los precios en el <a href="/ipc/">IPC de este mes</a>.</p>

      <h2>Cómo se calcula la subida</h2>
      <ol>
        <li><strong>Si tu alquiler está por encima del índice de referencia</strong> en una zona tensionada, hasta el {DECRETO.hasta} no te lo pueden subir.</li>
        <li><strong>Si el contrato no dice nada de actualizar la renta,</strong> no te la pueden subir: la ley solo permite actualizarla si se pactó.</li>
        <li><strong>Si no hay un nuevo acuerdo,</strong> la subida es la que diga el contrato, con un máximo del {DECRETO.tope} %. Si el contrato dice que se actualiza sin decir el índice, se usa el IRAV.</li>
        <li><strong>Si casero e inquilino acuerdan otra subida,</strong> vale lo acordado, pero nunca por encima del IRAV.</li>
      </ol>
      <p>La subida se aplica una vez al año, en la fecha en que se cumple el contrato, y el casero tiene que avisarte por escrito con un mes de antelación como mínimo. Si te la aplica sin avisar o por encima del máximo, puedes negarte a pagar la diferencia.</p>

      <h2>Ejemplo</h2>
      <p>Pagas 900 € y tu contrato dice que sube con el IPC. Con el IPC al {fmt(ipc)}, antes del decreto te podían subir hasta el IRAV ({fmt(iravHoy)}). Con el decreto, si no aceptas otra subida, el máximo es el {DECRETO.tope} %: 18 € más al mes, 918 €.</p>

      <p>Otras cosas que te pueden interesar si vives de alquiler: <a href="/vivienda/prorroga-del-alquiler-de-dos-anos-no-es-automatica-y-hay-que-pedirla/">cuándo se aplica la prórroga de dos años</a>, <a href="/vivienda/podras-descontar-del-alquiler-una-reparacion-si-el-dueno-no-responde-en-15/">cómo descontar una reparación del alquiler</a> y <a href="/vivienda/comprar-o-alquilar/">si te compensa comprar o seguir de alquiler</a>.</p>

      <p class="muted small">Fuentes: <a href="https://www.boe.es/buscar/act.php?id=BOE-A-2026-20823" rel="noopener">Real Decreto-ley 29/2026 (BOE)</a>, <a href="https://www.boe.es/buscar/act.php?id=BOE-A-1994-26003" rel="noopener">Ley de Arrendamientos Urbanos, artículo 18 y disposición adicional undécima (BOE)</a> e <a href="https://www.ine.es/dyngs/Prensa/IPC.htm" rel="noopener">INE</a>. Calculadora orientativa: si tienes un conflicto con tu casero, consulta en la oficina de vivienda de tu comunidad o en una asociación de inquilinos.</p>
    </section>
    <Siguenos />
  </article>
</Base>

<script type="application/json" id="datos-alq" set:html={JSON.stringify(DATOS)} />
<script>
  const D = JSON.parse(document.getElementById('datos-alq')!.textContent!) as { ipc: number | null; irav: number | null; tope: number | null };
  const form = document.getElementById('calc-alq') as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id)!;
  const eur = (n: number) => n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2, useGrouping: 'always' } as Intl.NumberFormatOptions) + ' €';
  const pc = (n: number) => n.toLocaleString('es-ES', { maximumFractionDigits: 2 }) + ' %';
  const irav = D.irav ?? 0, ipc = D.ipc ?? 0;

  function indiceContrato(clausula: string) {
    if (clausula === 'ipc') return { v: ipc, nombre: `el IPC (${pc(ipc)})` };
    if (clausula === 'ninguna') return { v: 0, nombre: '' };
    return { v: irav, nombre: `el IRAV (${pc(irav)})` };
  }

  function calcular() {
    const renta = Math.max(0, +(form.renta as HTMLInputElement).value || 0);
    const clausula = (form.clausula as HTMLSelectElement).value;
    const firma = (form.firma as HTMLSelectElement).value;
    const pacto = (form.pacto as HTMLSelectElement).value === 'si';
    const pactada = Math.max(0, +(form.pactada as HTMLInputElement).value || 0);
    const tensionada = (form.tensionada as HTMLInputElement).checked;
    $('campo-pactada').hidden = !pacto;
    const ind = indiceContrato(clausula);

    // Reglas sin el decreto: el IRAV como tope para contratos desde el 26/5/2023; los anteriores, lo que diga el contrato
    const sinDecreto = clausula === 'ninguna' ? 0 : firma === 'nuevo' ? Math.min(pacto ? pactada : ind.v, irav) : (pacto ? pactada : ind.v);

    let sube: number, motivo: string;
    if (D.tope == null) { sube = sinDecreto; motivo = 'Con las reglas generales de la ley.'; }
    else if (tensionada) { sube = 0; motivo = 'Tu alquiler supera el índice de referencia: hasta finales de 2027 no te lo pueden subir.'; }
    else if (clausula === 'ninguna' && !pacto) { sube = 0; motivo = 'Tu contrato no prevé actualizar la renta, así que no te la pueden subir.'; }
    else if (pacto) { sube = Math.min(pactada, irav); motivo = pactada > irav ? `Habéis pactado ${pc(pactada)}, pero el máximo legal es el IRAV (${pc(irav)}).` : `Vale lo que habéis acordado, que no supera el IRAV (${pc(irav)}).`; }
    else {
      sube = Math.max(0, Math.min(ind.v, D.tope, irav));
      motivo = ind.v > D.tope ? `Tu contrato sube con ${ind.nombre}, pero sin un nuevo acuerdo el máximo es el ${pc(D.tope)}.` : `Tu contrato sube con ${ind.nombre}, por debajo del límite del ${pc(D.tope)}.`;
    }
    sube = Math.max(0, Math.round(sube * 100) / 100);
    const extra = renta * sube / 100;
    $('veredicto').innerHTML = sube === 0 ? 'Este año <strong>no te pueden subir</strong> el alquiler.' : `Te pueden subir como máximo <strong>${eur(extra)} al mes</strong>.`;
    $('r-pct').textContent = pc(sube);
    $('r-nuevo').textContent = eur(renta + extra);
    $('r-detalle').textContent = extra > 0 ? `${motivo} Son ${eur(extra * 12)} más al año.` : motivo;
    const sinExtra = renta * Math.max(0, sinDecreto) / 100;
    $('r-sin').textContent = D.tope == null ? '' : `Si el decreto decae: te podrían subir un ${pc(Math.round(sinDecreto * 100) / 100)}, ${eur(sinExtra)} al mes (${eur(renta + sinExtra)}).`;
  }
  form.addEventListener('input', calcular);
  form.addEventListener('change', calcular);
  calcular();
</script>

<style>
  .pagina { max-width: 860px; }
  h1 { font-size: clamp(1.9rem, 4.6vw, 2.6rem); line-height: 1.15; margin: 4px 0 12px; }
  .lead { font-size: 1.125rem; line-height: 1.55; margin: 0 0 24px; max-width: 720px; }
  .res { background: var(--surface); border-radius: 4px; padding: 22px 24px; border-top: 2px solid var(--ink); }
  .veredicto { font-family: var(--serif); font-size: 1.5rem; line-height: 1.3; margin: 0 0 14px; }
  .veredicto :global(strong) { color: var(--brand-dark); }
  .dos { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 8px; }
  .dos p { margin: 0; display: flex; flex-direction: column; font-size: .875rem; }
  .dos strong { font-size: 1.375rem; font-variant-numeric: tabular-nums; }
  .small { font-size: .875rem; margin: 6px 0 0; }
  .formulario { margin-top: 24px; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px 20px; }
  .campo { display: flex; flex-direction: column; gap: 6px; }
  .campo[hidden] { display: none; }
  .campo > span:first-child { font-weight: 600; font-size: .875rem; }
  .u { position: relative; display: block; }
  .u i { position: absolute; right: 11px; top: 50%; transform: translateY(-50%); font-style: normal; color: var(--muted); font-size: .875rem; }
  .u input, select { font: 400 1rem var(--sans); padding: 9px 11px; border: 1px solid #b9c0c6; border-radius: 4px; width: 100%; color: var(--ink); background: var(--bg); }
  .u input { padding-right: 60px; font-variant-numeric: tabular-nums; }
  .check { grid-column: 1 / -1; display: flex; gap: 10px; align-items: flex-start; font-size: .9375rem; }
  .check input { margin-top: 4px; width: 18px; height: 18px; flex: none; }
  .aviso { margin: 24px 0; padding: 14px 16px; border-left: 3px solid var(--brand); background: var(--surface); font-size: .9375rem; }
  .prose { margin-top: 32px; }
  @media (max-width: 600px) {
    .res { padding: 18px 16px; }
    .dos { grid-template-columns: 1fr; }
    .veredicto { font-size: 1.25rem; }
  }
</style>
