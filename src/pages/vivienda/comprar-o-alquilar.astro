---
import Base from '../../layouts/Base.astro';
import Siguenos from '../../components/Siguenos.astro';
import Compartir from '../../components/Compartir.astro';
import { SITE } from '../../config';

const titulo = '¿Comprar o alquilar? Calculadora';
const descripcion = 'Compara cuánto dinero tendrías dentro de unos años si compras una vivienda con hipoteca o si sigues de alquiler e inviertes la diferencia.';
const url = `${SITE.url}/vivienda/comprar-o-alquilar/`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Vivienda', item: `${SITE.url}/vivienda/` },
      { '@type': 'ListItem', position: 3, name: titulo, item: url },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: titulo, url, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', inLanguage: 'es-ES', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' } },
];
const campo = (name: string, etiqueta: string, valor: number, unidad: string, paso = 1, ayuda?: string) => ({ name, etiqueta, valor, unidad, paso, ayuda });
const grupos = [
  { titulo: 'La vivienda', campos: [
    campo('precio', 'Precio de la vivienda', 250000, '€', 1000),
    campo('entradaPct', 'Entrada', 20, '%', 1, 'Los bancos suelen financiar el 80 %.'),
    campo('impuestosCompraPct', 'Impuestos de la compra', 7, '%', 0.5, 'Vivienda usada: ITP, del 6 % al 10 % según la comunidad. Nueva: 10 % de IVA más el AJD.'),
    campo('otrosGastosCompraPct', 'Notaría, registro y gestoría', 1.5, '%', 0.1),
    campo('gastosPropietarioPct', 'IBI, comunidad, seguro y reparaciones al año', 1, '%', 0.1, 'En porcentaje del valor de la vivienda.'),
    campo('revalorizacion', 'Lo que sube el precio de la vivienda al año', 2, '%', 0.5),
  ]},
  { titulo: 'La hipoteca', campos: [
    campo('tipoHipoteca', 'Tipo de interés (fijo)', 3, '%', 0.05),
    campo('plazoHipoteca', 'Plazo', 30, 'años', 1),
  ]},
  { titulo: 'El alquiler', campos: [
    campo('alquiler', 'Alquiler de una vivienda parecida', 1000, '€/mes', 25),
    campo('subidaAlquiler', 'Subida del alquiler al año', 2, '%', 0.5),
  ]},
  { titulo: 'Otros supuestos', campos: [
    campo('rentabilidad', 'Rentabilidad de invertir el dinero', 4, '%', 0.5, 'Lo que ganaría al año, después de comisiones, el dinero que no gastas en la compra.'),
    campo('gastosVentaPct', 'Gastos si vendes la vivienda', 5, '%', 0.5, 'Agencia, plusvalía municipal, cancelación de la hipoteca.'),
    campo('anios', 'Años que piensas quedarte', 15, 'años', 1),
  ]},
];
---
<Base title={titulo} description={descripcion} jsonLd={jsonLd}>
  <nav class="breadcrumbs"><a href="/">Inicio</a> › <a href="/vivienda/">Vivienda</a></nav>
  <article class="pagina">
    <h1>{titulo}</h1>
    <p class="lead">Compara el dinero que tendrías al cabo de unos años en los dos casos: si compras con hipoteca o si sigues de alquiler e inviertes lo que te ahorras. Cambia los datos para que se parezcan a tu situación.</p>

    <section class="res" aria-live="polite">
      <p class="veredicto" id="veredicto">—</p>
      <div class="dos">
        <p><span class="muted">Si compras, tendrías</span><strong id="r-compra">—</strong></p>
        <p><span class="muted">Si alquilas, tendrías</span><strong id="r-alquiler">—</strong></p>
      </div>
      <p class="muted small" id="r-detalle"></p>
      <figure class="grafico">
        <svg id="grafico" viewBox="0 0 720 240" role="img" aria-label="Patrimonio año a año si compras y si alquilas"></svg>
        <figcaption><span class="ley compra"></span>Si compras <span class="ley alq"></span>Si alquilas e inviertes</figcaption>
      </figure>
    </section>

    <form id="calc-ca" class="formulario" novalidate>
      {grupos.map((g) => (
        <fieldset>
          <legend>{g.titulo}</legend>
          <div class="campos">
            {g.campos.map((c) => (
              <label class="campo">
                <span>{c.etiqueta}</span>
                <span class="u"><input name={c.name} type="number" inputmode="decimal" step={c.paso} min="0" value={c.valor} /><i>{c.unidad}</i></span>
                {c.ayuda && <small class="muted">{c.ayuda}</small>}
              </label>
            ))}
          </div>
        </fieldset>
      ))}
    </form>

    <Compartir title={titulo} url={url} />

    <section class="prose">
      <h2>Cómo hacemos la comparación</h2>
      <p>Para que sea justa, las dos opciones parten del mismo dinero y gastan lo mismo cada mes:</p>
      <ul>
        <li><strong>Si compras,</strong> pagas la entrada y los gastos de compra al principio. Después pagas cada mes la cuota de la hipoteca y los gastos de propietario. Tu patrimonio es lo que valdría la vivienda si la vendieras, menos los gastos de venta y lo que quede de hipoteca.</li>
        <li><strong>Si alquilas,</strong> inviertes el dinero de la entrada y los gastos. Cada mes pagas el alquiler. Si te sale más barato que comprar, inviertes la diferencia; si sale más caro, es quien compra quien invierte la diferencia.</li>
      </ul>
      <p>El resultado depende mucho de tres supuestos que nadie conoce de antemano: lo que suba la vivienda, lo que suba el alquiler y lo que rinda el dinero invertido. Prueba con valores prudentes y con valores optimistas para ver hacia dónde se inclina tu caso.</p>
      <h2>Qué suele inclinar la balanza</h2>
      <ul>
        <li><strong>El tiempo.</strong> Comprar tiene unos gastos de entrada y de salida altos: impuestos, notaría, agencia. Hacen falta años para compensarlos. Si te vas a mudar pronto, el alquiler suele salir mejor.</li>
        <li><strong>La relación entre el precio y el alquiler.</strong> Si el precio de compra equivale a más de unos 20 años de alquiler, comprar suele compensar menos.</li>
        <li><strong>El tipo de la hipoteca.</strong> Cuanto más bajo es, más ventaja tiene comprar. Si tu hipoteca es variable, mira cómo va el <a href="/vivienda/euribor-hoy/">euríbor hoy</a>.</li>
      </ul>
      <p class="muted small">Calculadora orientativa. No tiene en cuenta los impuestos sobre la rentabilidad de las inversiones, las deducciones fiscales, las ayudas a la compra ni la plusvalía en el IRPF al vender.</p>
    </section>
    <Siguenos />
  </article>
</Base>

<script>
  import { simular, anioEquilibrio, cuotaHipoteca, type Supuestos } from '../../lib/comprar-alquilar';
  const form = document.getElementById('calc-ca') as HTMLFormElement;
  const svg = document.getElementById('grafico')!;
  const eur = (n: number) => Math.round(n).toLocaleString('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions) + ' €';
  const $ = (id: string) => document.getElementById(id)!;

  function leer(): Supuestos {
    const d = new FormData(form);
    const o: any = {};
    for (const [k, v] of d.entries()) o[k] = parseFloat(String(v).replace(',', '.')) || 0;
    o.anios = Math.min(40, Math.max(1, Math.round(o.anios)));
    o.plazoHipoteca = Math.max(1, Math.round(o.plazoHipoteca));
    return o as Supuestos;
  }

  function dibujar(r: ReturnType<typeof simular>) {
    const W = 720, H = 240, t = 14, b = 28, l = 64, rr = 10;
    const vals = r.flatMap((x) => [x.patrimonioCompra, x.patrimonioAlquiler]);
    const max = Math.max(...vals, 0) * 1.05, min = Math.min(...vals, 0);
    const x = (i: number) => l + (i * (W - l - rr)) / Math.max(1, r.length - 1);
    const y = (v: number) => t + ((max - v) * (H - t - b)) / (max - min || 1);
    const linea = (k: 'patrimonioCompra' | 'patrimonioAlquiler') => r.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p[k]).toFixed(1)}`).join(' ');
    const paso = Math.pow(10, Math.floor(Math.log10(max || 1)));
    const marca = max / paso > 5 ? paso : paso / 2;
    let rej = '';
    for (let v = 0; v <= max; v += marca) rej += `<line x1="${l}" x2="${W - rr}" y1="${y(v)}" y2="${y(v)}" class="rej"/><text x="${l - 6}" y="${y(v) + 4}" text-anchor="end">${Math.round(v / 1000).toLocaleString('es-ES')} mil</text>`;
    let ejeX = '';
    const cada = r.length > 20 ? 5 : r.length > 10 ? 2 : 1;
    r.forEach((p, i) => { if (p.anio % cada === 0 || i === 0) ejeX += `<text x="${x(i)}" y="${H - 8}" text-anchor="middle">${p.anio}</text>`; });
    svg.innerHTML = `${rej}${ejeX}<path d="${linea('patrimonioAlquiler')}" class="l-alq"/><path d="${linea('patrimonioCompra')}" class="l-compra"/>`;
  }

  function calcular() {
    const s = leer();
    const r = simular(s);
    const fin = r[r.length - 1];
    const eq = anioEquilibrio(r);
    const dif = fin.patrimonioCompra - fin.patrimonioAlquiler;
    $('r-compra').textContent = eur(fin.patrimonioCompra);
    $('r-alquiler').textContent = eur(fin.patrimonioAlquiler);
    $('veredicto').innerHTML = Math.abs(dif) < 1000
      ? `A ${s.anios} años, <strong>prácticamente da igual</strong>.`
      : `A ${s.anios} años, <strong>${dif > 0 ? 'comprar' : 'alquilar'} sale mejor</strong> por unos ${eur(Math.abs(dif))}.`;
    const cuota = cuotaHipoteca(s.precio * (1 - s.entradaPct / 100), s.tipoHipoteca, s.plazoHipoteca);
    const inicial = (s.precio * (s.entradaPct + s.impuestosCompraPct + s.otrosGastosCompraPct)) / 100;
    $('r-detalle').textContent = `Dinero inicial para comprar: ${eur(inicial)}. Cuota de la hipoteca: ${eur(cuota)} al mes. ` +
      (eq == null ? 'Con estos datos, comprar no llega a compensar en el plazo elegido.' : eq === 1 ? 'Comprar compensa desde el primer año.' : `Comprar empieza a compensar a partir del año ${eq}.`);
    dibujar(r);
  }
  form.addEventListener('input', calcular);
  calcular();
</script>

<style>
  .pagina { max-width: 860px; }
  h1 { font-size: clamp(1.9rem, 4.6vw, 2.6rem); line-height: 1.15; margin: 4px 0 12px; }
  .lead { font-size: 1.125rem; line-height: 1.55; margin: 0 0 24px; max-width: 720px; }
  .res { background: var(--surface); border-radius: 4px; padding: 22px 24px; border-top: 2px solid var(--ink); }
  .veredicto { font-family: var(--serif); font-size: 1.5rem; line-height: 1.3; margin: 0 0 14px; }
  .veredicto :global(strong) { color: var(--brand-dark); }
  .dos { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 8px; }
  .dos p { margin: 0; display: flex; flex-direction: column; font-size: .875rem; }
  .dos strong { font-size: 1.375rem; font-variant-numeric: tabular-nums; }
  .small { font-size: .8125rem; }
  .grafico { margin: 14px 0 0; }
  .grafico svg { width: 100%; height: auto; display: block; }
  .grafico :global(text) { font: 400 11px var(--sans); fill: var(--muted); }
  .grafico :global(.rej) { stroke: var(--rule); }
  .grafico :global(.l-compra) { fill: none; stroke: var(--brand); stroke-width: 2.5; }
  .grafico :global(.l-alq) { fill: none; stroke: var(--mid); stroke-width: 2.5; stroke-dasharray: 6 4; }
  figcaption { font-size: .8125rem; color: var(--muted); display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .ley { display: inline-block; width: 18px; height: 0; border-top: 3px solid var(--brand); margin-left: 8px; }
  .ley.alq { border-top: 3px dashed var(--mid); }
  .formulario { margin-top: 28px; display: flex; flex-direction: column; gap: 24px; }
  fieldset { border: 0; margin: 0; padding: 0; }
  legend { font-family: var(--serif); font-weight: 600; font-size: 1.25rem; margin-bottom: 10px; padding: 0; }
  .campos { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px 20px; }
  .campo { display: flex; flex-direction: column; gap: 6px; }
  .campo > span:first-child { font-weight: 600; font-size: .875rem; }
  .campo small { font-size: .78rem; line-height: 1.4; }
  .u { position: relative; display: block; }
  .u i { position: absolute; right: 11px; top: 50%; transform: translateY(-50%); font-style: normal; color: var(--muted); font-size: .875rem; }
  .u input { font: 400 1rem var(--sans); padding: 9px 60px 9px 11px; border: 1px solid #b9c0c6; border-radius: 4px; width: 100%; color: var(--ink); background: var(--bg); font-variant-numeric: tabular-nums; }
  .u input:focus { outline: 2px solid var(--brand); outline-offset: 0; }
  .prose { margin-top: 36px; }
  @media (max-width: 600px) {
    .res { padding: 18px 16px; }
    .dos { grid-template-columns: 1fr; }
    .veredicto { font-size: 1.25rem; }
  }
</style>
