---
import fs from 'node:fs';
import { srcset } from '../../lib/img';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Compartir from '../../components/Compartir.astro';
import Siguenos from '../../components/Siguenos.astro';
import { CATEGORIES, SITE } from '../../config';
import { getPublishedPosts, formatDate, formatDateTime, readingTime, relacionados } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { category: post.data.category, slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const cat = CATEGORIES[d.category];
const url = `${SITE.url}/${d.category}/${post.id}/`;
const related = relacionados(post, all, 3);
const img = d.image ?? `/img/portadas/${d.category}.webp`;
const autorUrl = `/autor/${SITE.author.slug}/`;
// La portada en 16:9, 4:3 y 1:1 (si existen los recortes), como recomienda Google para Discover
const imagenesSchema = [img, img.replace(/\.webp$/, '-4x3.webp'), img.replace(/\.webp$/, '-1x1.webp')]
  .filter((s, i) => i === 0 || fs.existsSync(`public${s}`))
  .map((s) => new URL(s, SITE.url).href);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': d.guia ? 'Article' : 'NewsArticle',
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    inLanguage: 'es',
    mainEntityOfPage: url,
    image: imagenesSchema,
    author: { '@type': 'Person', name: SITE.author.name, url: SITE.url + autorUrl },
    publisher: {
      '@type': 'Organization', name: SITE.name, url: SITE.url,
      logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png`, width: 512, height: 512 },
    },
    isAccessibleForFree: true,
    articleSection: cat.label,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: cat.label, item: `${SITE.url}/${d.category}/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
const actualizado = d.updated && d.updated.getTime() - d.date.getTime() > 36e5;
---
<Base title={d.title} description={d.description} image={img} type="article" jsonLd={jsonLd} published={d.date} modified={d.updated ?? d.date} section={cat.label}>
  <article class="post" data-pagefind-body>
    <nav class="breadcrumbs" data-pagefind-ignore><a href="/">Inicio</a> › <a href={`/${d.category}/`}>{cat.label}</a></nav>
    <header>
      <a class="tag" href={`/${d.category}/`}>{cat.label}</a>
      {d.guia && <span class="tag guia">Guía actualizada</span>}
      {d.pendiente && <span class="tag pendiente">Pendiente del BOE</span>}
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      <p class="meta muted small">
        Por <a href={autorUrl} rel="author">{SITE.author.name}</a> ·
        {d.guia
          ? <>Actualizado el <time datetime={(d.updated ?? d.date).toISOString()}>{formatDate(d.updated ?? d.date)}</time></>
          : <>
              <time datetime={d.date.toISOString()} data-rel>{formatDateTime(d.date)}</time>
              {actualizado && <> · Actualizado el <time datetime={d.updated!.toISOString()}>{formatDate(d.updated!)}</time></>}
            </>}
        · {readingTime(post.body ?? '')} min de lectura
      </p>
    </header>
    <figure class="hero">
      <img data-pagefind-meta="image[src]" fetchpriority="high" decoding="async" src={img} srcset={srcset(img)} sizes="(max-width: 800px) 100vw, 760px" alt={d.image ? (d.imageAlt ?? '') : ''} width="1600" height="900" />
      {d.image && d.imageCredit && <figcaption class="credit">Imagen: {d.imageCredit}</figcaption>}
    </figure>
    {d.pendiente && (
      <p class="pendiente-nota"><strong>Todavía no es oficial.</strong> Lo que cuenta este artículo está anunciado o en tramitación, pero aún no se ha publicado en el Boletín Oficial del Estado y puede cambiar. Lo actualizaremos cuando se apruebe.</p>
    )}
    <AdSlot />
    <div class="prose"><Content /></div>

    {d.sources.length > 0 && (
      <aside class="sources">
        <strong>{d.sources.length === 1 ? 'Fuente' : 'Fuentes'}</strong>
        <ul>{d.sources.map((s: any) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a></li>)}</ul>
      </aside>
    )}
    {d.correcciones.length > 0 && (
      <aside class="correcciones">
        <strong>Correcciones</strong>
        <ul>{d.correcciones.map((c: any) => <li><time datetime={c.fecha.toISOString()}>{formatDate(c.fecha)}</time>: {c.texto}</li>)}</ul>
      </aside>
    )}
    <p class="aviso-general muted small">Esta información es general y no tiene en cuenta tu situación personal. Ante cualquier duda, consulta la fuente oficial o el organismo correspondiente. ¿Has visto un error? <a href="/contacto/">Avísanos</a> y lo corregimos.</p>
    <Compartir url={url} title={d.title} />
    <Siguenos />
    <AdSlot />
  </article>

  {related.length > 0 && (
    <section class="related">
      <h2>También te puede interesar</h2>
      <div class="grid">{related.map((p: any) => <PostCard post={p} />)}</div>
    </section>
  )}
</Base>
<style>
  .meta a { color: inherit; text-decoration: underline; text-decoration-color: #18222e44; text-underline-offset: 3px; }
  .post { max-width: 760px; }
  h1 { font-size: clamp(1.9rem, 5.5vw, 2.8rem); margin: 12px 0 10px; }
  .lead { font-size: 1.18rem; color: var(--muted); margin: 0 0 10px; }
  .tag + .tag { margin-left: 4px; }
  .hero { margin: 20px 0 0; }
  .hero img { border-radius: var(--radius); width: 100%; display: block; }
  .credit { font-size: .8rem; color: var(--muted); margin-top: 6px; }
  .pendiente-nota { border: 1px solid #e7c08b; background: var(--amber-soft); border-radius: var(--radius); padding: 12px 16px; font-size: .95rem; margin-top: 20px; }
  .sources, .correcciones { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; margin-top: 28px; font-size: .95rem; }
  .correcciones { border-color: #e7c08b; background: var(--amber-soft); }
  .sources ul, .correcciones ul { margin: 6px 0 0; padding-left: 18px; }
  .aviso-general { margin-top: 20px; }
  .related { margin-top: 56px; }
  .related h2 { font-size: 1.6rem; }
</style>
