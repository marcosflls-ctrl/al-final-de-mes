---
// Precio de la luz de un día: resumen, gráfico por horas y tabla. Datos de src/data/luz.json.
interface Hora { h: string; p: number }
interface Props { titulo: string; horas: Hora[]; id: string }
const { titulo, horas, id } = Astro.props;

const eur = (p: number) => p.toLocaleString('es-ES', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
const media = horas.reduce((s, x) => s + x.p, 0) / horas.length;
const orden = [...horas].sort((a, b) => a.p - b.p);
const min = orden[0], max = orden[orden.length - 1];
const baratas = orden.slice(0, 3).sort((a, b) => a.h.localeCompare(b.h));
// tres tramos según el precio de ese día: el tercio más barato, el medio y el más caro
const t1 = orden[Math.floor(horas.length / 3)].p, t2 = orden[Math.floor((2 * horas.length) / 3)].p;
const tramo = (p: number) => (p < t1 ? 'barata' : p < t2 ? 'media' : 'cara');
const fin = (h: string) => `${String((parseInt(h, 10) + 1) % 24).padStart(2, '0')}:00`;

// gráfico de barras
const W = 720, H = 220, top = 16, bottom = 28, left = 8;
const bw = (W - left * 2) / horas.length;
const escala = (p: number) => ((H - top - bottom) * p) / (max.p * 1.08);
---
<section class="luz-dia" aria-labelledby={`${id}-t`}>
  <h2 id={`${id}-t`} class="titulo-bloque">{titulo}</h2>
  <dl class="resumen">
    <div><dt>Precio medio</dt><dd>{eur(media)} €/kWh</dd></div>
    <div><dt>Hora más barata</dt><dd class="bien">{min.h}–{fin(min.h)}<span>{eur(min.p)} €/kWh</span></dd></div>
    <div><dt>Hora más cara</dt><dd class="mal">{max.h}–{fin(max.h)}<span>{eur(max.p)} €/kWh</span></dd></div>
  </dl>
  <p class="consejo">Las tres horas más baratas son {baratas.map((x) => `${x.h}–${fin(x.h)}`).join(', ').replace(/, ([^,]*)$/, ' y $1')}: el mejor momento para la lavadora, el lavavajillas o cargar el coche.</p>

  <figure class="grafico">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Precio de la luz por horas: mínimo ${eur(min.p)} €/kWh a las ${min.h}, máximo ${eur(max.p)} €/kWh a las ${max.h}`}>
      <line x1={left} x2={W - left} y1={H - bottom} y2={H - bottom} class="eje" />
      <line x1={left} x2={W - left} y1={H - bottom - escala(media)} y2={H - bottom - escala(media)} class="media" />
      {horas.map((x, i) => (
        <rect class={tramo(x.p)} x={left + i * bw + 1.5} width={bw - 3} y={H - bottom - escala(x.p)} height={escala(x.p)}><title>{x.h}: {eur(x.p)} €/kWh</title></rect>
      ))}
      {horas.map((x, i) => i % 3 === 0 && (
        <text x={left + i * bw + bw / 2} y={H - 8} text-anchor="middle">{x.h.slice(0, 5)}</text>
      ))}
    </svg>
    <figcaption><span class="ley barata"></span>Horas más baratas del día <span class="ley media"></span>Intermedias <span class="ley cara"></span>Más caras. La línea discontinua marca el precio medio.</figcaption>
  </figure>

  <details class="tabla">
    <summary>Precio de cada hora</summary>
    <table>
      <thead><tr><th>Hora</th><th>€/kWh</th><th>Tramo</th></tr></thead>
      <tbody>
        {horas.map((x) => (
          <tr><td>{x.h}–{fin(x.h)}</td><td>{eur(x.p)}</td><td><span class:list={['punto', tramo(x.p)]}></span>{tramo(x.p) === 'barata' ? 'Barata' : tramo(x.p) === 'cara' ? 'Cara' : 'Intermedia'}</td></tr>
        ))}
      </tbody>
    </table>
  </details>
</section>
<style>
  .luz-dia { margin: 8px 0 44px; }
  .resumen { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; border-bottom: 1px solid var(--rule); }
  .resumen div { padding: 4px 20px 14px 0; }
  .resumen div + div { padding-left: 20px; border-left: 1px solid var(--rule); }
  dt { font-size: .875rem; color: var(--muted); }
  dd { margin: 2px 0 0; font-family: var(--serif); font-weight: 600; font-size: 1.6rem; line-height: 1.2; font-variant-numeric: tabular-nums; }
  dd span { display: block; font-family: var(--sans); font-weight: 400; font-size: .875rem; color: var(--muted); }
  .bien { color: var(--good); }
  .mal { color: var(--bad); }
  .consejo { margin: 16px 0 10px; max-width: 70ch; }
  .grafico { margin: 8px 0 0; }
  .grafico svg { width: 100%; height: auto; display: block; }
  .grafico text { font-size: 12px; fill: var(--muted); font-family: var(--sans); }
  .eje { stroke: var(--ink); stroke-width: 1; }
  .media { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 3 4; opacity: .5; }
  rect.barata, .punto.barata, .ley.barata { fill: var(--good); background: var(--good); }
  rect.media, .punto.media, .ley.media { fill: #d9b46a; background: #d9b46a; }
  rect.cara, .punto.cara, .ley.cara { fill: var(--bad); background: var(--bad); }
  figcaption { font-size: .8125rem; color: var(--muted); margin-top: 6px; }
  .ley { display: inline-block; width: 10px; height: 10px; margin: 0 5px 0 12px; vertical-align: -1px; }
  .ley:first-child { margin-left: 0; }
  .tabla { margin-top: 14px; }
  .tabla summary { cursor: pointer; font-weight: 500; color: var(--brand); padding: 6px 0; }
  table { border-collapse: collapse; width: 100%; max-width: 480px; margin-top: 8px; font-variant-numeric: tabular-nums; }
  th, td { border-bottom: 1px solid var(--rule); padding: 7px 12px 7px 0; text-align: left; font-size: .9375rem; }
  th { font-weight: 600; border-bottom-color: var(--ink); }
  .punto { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 7px; }
  @media (max-width: 640px) {
    .resumen { grid-template-columns: 1fr; }
    .resumen div, .resumen div + div { padding: 10px 0; border-left: 0; border-top: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    dd { font-size: 1.2rem; text-align: right; }
  }
</style>
