---
// Marca: una hoja de calendario con el último día marcado, más el nombre.
interface Props { size?: number }
const { size = 32 } = Astro.props;
---
<span class="marca">
  <svg class="mark" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#0d5c45"/>
    <rect x="7" y="9" width="18" height="16" rx="2.5" fill="none" stroke="#fff" stroke-width="2"/>
    <path d="M7 13.5h18" stroke="#fff" stroke-width="2"/>
    <path d="M11.5 6.5v4M20.5 6.5v4" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
    <circle cx="20.5" cy="20" r="2.6" fill="#f2a93b"/>
  </svg>
  <span class="nombre">Al Final <em>de</em> Mes</span>
</span>
<style>
  .marca { display: inline-flex; align-items: center; gap: 9px; }
  .mark { display: block; flex: none; }
  .nombre { font-family: 'Source Serif 4', Georgia, serif; font-weight: 700; font-size: 1.2rem; letter-spacing: -.01em; color: var(--text); white-space: nowrap; }
  .nombre em { font-style: italic; font-weight: 600; color: var(--green-2); }
</style>
