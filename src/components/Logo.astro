---
// Marca: hoja de calendario con el último día marcado, y el nombre.
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<span class="marca">
  <svg class="mark" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true">
    <rect width="32" height="32" rx="5" fill="#0b5d4b"/>
    <rect x="7" y="9" width="18" height="16" rx="1.5" fill="none" stroke="#fff" stroke-width="2"/>
    <path d="M7 13.5h18" stroke="#fff" stroke-width="2"/>
    <path d="M11.5 6.5v4M20.5 6.5v4" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
    <rect x="18" y="17.5" width="4.5" height="4.5" fill="#fff"/>
  </svg>
  <span class="nombre">Al Final de Mes</span>
</span>
<style>
  .marca { display: inline-flex; align-items: center; gap: 10px; }
  .mark { display: block; flex: none; }
  .nombre { font-family: var(--serif); font-weight: 600; font-size: 1.3rem; color: var(--ink); white-space: nowrap; }
</style>
